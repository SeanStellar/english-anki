{
  "name": "english-anki",
  "version": "4.2.0",
  "description": "熟词锚点记忆与 FSRS 间隔复习一体化英语学习桌面应用",
  "main": "main.js",
  "author": "English Anki",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:integration": "node tests/electron-restore.integration.cjs",
    "audit:vocabulary": "python tools/audit_vocabulary.py",
    "pack": "electron-builder --win --x64 --dir",
    "dist": "electron-builder --win nsis portable --x64"
  },
  "devDependencies": {
    "electron": "37.10.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.englishanki.app",
    "productName": "英语 Anki",
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "asar": true,
    "asarUnpack": [
      "renderer/assets/memory-scenes/**"
    ],
    "files": [
      "main.js",
      "preload.bundle.js",
      "apkg-export.js",
      "backup-utils.js",
      "integration-utils.js",
      "package.json",
      "LICENSE",
      "LICENSE-ASSETS.md",
      "LICENSE-ASSETS.txt",
      "COMMERCIAL-LICENSE.md",
      "renderer/**/*",
      "build/icon.ico",
      "!**/*.bak*",
      "!**/*.map",
      "!**/README*",
      "!tests/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "guid": "4fe11a6f-4f33-53ed-9b20-bb20ac642d03",
      "artifactName": "English-Anki-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "English-Anki-${version}-Portable.${ext}"
    }
  },
  "dependencies": {
    "anki-apkg-export": "5.0.0"
  }
}
