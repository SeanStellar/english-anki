{
  "name": "english-anki",
  "version": "4.4.1",
  "description": "熟词锚点记忆与 FSRS 间隔复习一体化英语学习桌面应用",
  "main": "main.js",
  "author": "English Anki",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "node tests/app-smoke.e2e.cjs",
    "test:integration": "node tests/electron-restore.integration.cjs",
    "audit:content": "node scripts/audit-content.js",
    "audit:vocabulary": "python tools/audit_vocabulary.py",
    "pack": "electron-builder --win --x64 --dir",
    "dist": "electron-builder --win nsis portable --x64",
    "build:preload": "node scripts/build-preload.js",
    "mobile:bridge": "node scripts/build-mobile-bridge.js",
    "mobile:scenes": "node scripts/compress-scenes.js",
    "mobile:web": "node scripts/build-mobile.js",
    "mobile:serve": "node scripts/mobile-serve.js",
    "mobile:test": "node scripts/mobile-flow.js",
    "mobile:sync": "cap sync android",
    "mobile:sync:ios": "cap sync ios",
    "mobile:open": "cap open android",
    "prepack": "npm run build:preload",
    "predist": "npm run build:preload"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "chrome-remote-interface": "^0.34.0",
    "electron": "37.10.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.27.0",
    "playwright-core": "^1.65.1",
    "sharp": "^0.35.5",
    "ts-fsrs": "5.4.1"
  },
  "build": {
    "appId": "com.englishanki.app",
    "productName": "英语 Anki",
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "asar": true,
    "asarUnpack": [
      "renderer/assets/memory-scenes/**",
      "renderer/audio/words/**"
    ],
    "files": [
      "main.js",
      "preload.bundle.js",
      "apkg-export.js",
      "backup-utils.js",
      "integration-utils.js",
      "package.json",
      "LICENSE",
      "LICENSE-ASSETS.md",
      "LICENSE-ASSETS.txt",
      "LICENSE-ECDICT.txt",
      "COMMERCIAL-LICENSE.md",
      "renderer/**/*",
      "build/icon.ico",
      "!**/*.bak*",
      "!**/*.map",
      "!**/README*",
      "!tests/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "guid": "4fe11a6f-4f33-53ed-9b20-bb20ac642d03",
      "deleteAppDataOnUninstall": false,
      "artifactName": "English-Anki-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "English-Anki-${version}-Portable.${ext}"
    }
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/screen-orientation": "^8.0.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "anki-apkg-export": "5.0.0"
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.27.0": true
  }
}
