{
  "appId": "com.englishanki.app",
  "appName": "英语 Anki",
  "webDir": "mobile-web",
  "android": {
    "backgroundColor": "#f6f7f9"
  },
  "ios": {
    "backgroundColor": "#f6f7f9",
    "contentInset": "never"
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "launchAutoHide": true,
      "launchFadeOutDuration": 200,
      "backgroundColor": "#111C43",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}
